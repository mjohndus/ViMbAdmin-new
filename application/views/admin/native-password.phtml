{tmplinclude file="header.phtml"}

<div class="page-content">

    <div class="page-header vimb-sub-header">
        <h1>
            New Password
            {if isset( $targetAdmin ) && $targetAdmin->getId() != $identity.user->getId()}
                <small class="text-muted fs-5 fw-normal"> for {$targetAdmin->getUsername()|escape}</small>
            {/if}
        </h1>
    </div>

    {OSS_Message}

    <div class="row justify-content-center mt-4">
        <div class="col-md-7 col-lg-6">

            <div class="vimb-login-form vimb-changepw-form mb-3">
                {$formHtml|replace:'value="Change Password"':'value="Submit"'|replace:'>Change Password<':'>Submit<' nofilter}
                <a class="btn btn-secondary vimb-btn-cancel" href="{genUrl controller='admin'}">Cancel</a>
            </div>

        </div>
    </div>

</div>

{tmplinclude file="footer.phtml"}
