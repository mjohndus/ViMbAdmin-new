{tmplinclude file="header.phtml"}

<div class="page-content">

    <div class="vimb-sub-header">
        <h1>Login to ViMbAdmin</h1>
    </div>

    {OSS_Message}

    <div class="row justify-content-center mt-4">
        <div class="col-md-6 col-lg-5">

            <div class="text-center mb-3">
                <img src="{genUrl}/images/logo_500x159.jpg" class="img-fluid" alt="ViMbAdmin" />
            </div>

            <p class="mb-4">
                Welcome to <em>ViMbAdmin</em>, a web application for managing your virtual mailboxes, domains and aliases.
            </p>

            <div class="vimb-login-form mb-4">
                {$formHtml nofilter}
            </div>

            <div class="card card-body bg-light">
                <div class="d-flex justify-content-between align-items-center gap-3">
                    <p class="mb-0">
                        Are you a user (mailbox owner) looking to change your
                        password? If so, please click on this button:
                    </p>
                    <a class="btn btn-primary text-nowrap" href="{genUrl controller="auth" action="change-password"}">Mailbox Password Change</a>
                </div>
            </div>

        </div>
    </div>

</div>

{tmplinclude file="footer.phtml"}
