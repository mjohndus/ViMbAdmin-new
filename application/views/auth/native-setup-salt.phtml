{include file='header.phtml'}

<style nonce="{$cspNonce}">
    .vimb-salt-box pre {
        background-color: #f8f9fa;
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        padding: 0.85rem 1rem;
        font-size: 0.9rem;
        color: #212529;
        user-select: all;
        margin-bottom: 1rem;
    }
</style>

<div class="page-content">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-11 col-md-9 col-lg-7">

                <div class="card shadow-sm rounded-3 mb-4 vimb-salt-box">
                    <div class="card-body p-4">

                        <div class="text-center mb-3">
                            <img src="{genUrl}/images/logo_500x159.jpg" alt="ViMbAdmin" class="img-fluid rounded-2 mb-3" style="max-height: 95px;" />
                            <h2 class="h4 mb-2">Welcome to ViMbAdmin</h2>
                            <p class="text-muted small mb-0">
                                Before you can create the first administrator, ViMbAdmin needs its security salts configured.
                            </p>
                        </div>

                        <hr class="my-3" />

                        <h3 class="h5 mb-2">Step 1: Security Salts</h3>

                        <p class="small text-muted">
                            <em>Security salts</em> are used to ensure your passwords are secure, you are authorised to complete the install procedure and for cookie security. To proceed, please set the following <strong>randomly generated</strong> salts in the <code>[user]</code> (or <code>[production]</code>) section of <code>application/configs/application.ini</code>:
                        </p>

                        <pre>securitysalt                       = "{$randomSalt}"
resources.auth.oss.rememberme.salt = "{$rememberSalt}"</pre>

                        <div class="alert alert-light border small mb-3">
                            <strong>Note:</strong> Please also ensure you have set all the appropriate values in <code>application/configs/application.ini</code> before continuing.
                        </div>

                        <div class="text-center">
                            <a href="" class="btn btn-primary rounded-2 px-4">
                                Reload Page
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

{include file='footer.phtml'}
