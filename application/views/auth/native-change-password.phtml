{tmplinclude file="header.phtml"}

<div class="page-content">

    <div class="page-header vimb-sub-header">
        <h1>Change Password</h1>
    </div>

    {OSS_Message}

    <div class="row justify-content-center mt-4">
        <div class="col-md-7 col-lg-6">

            <div class="text-center mb-3">
                <img src="{genUrl}/images/logo_500x159.jpg" class="img-fluid" alt="ViMbAdmin" />
            </div>

            <p class="mb-4">
                Change the password for your mailbox. Enter your email address, your
                current password, and the new password twice.
            </p>

            <div class="vimb-login-form vimb-changepw-form mb-3">
                {$formHtml|replace:'value="Change Password"':'value="Submit"'|replace:'>Change Password<':'>Submit<' nofilter}
                <a class="btn btn-secondary vimb-btn-cancel" href="{genUrl controller="auth" action="login"}">Cancel</a>
            </div>

        </div>
    </div>

</div>

{tmplinclude file="footer.phtml"}
